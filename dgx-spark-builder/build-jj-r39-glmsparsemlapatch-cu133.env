# build-jj-r39-glmsparsemlapatch-cu133.env -- r39 + the GLM-5.3 pooled-indexer
# fix, on the CUDA 13.3 / torch 2.13 foundation. Same shape as
# build-jj-r39-cu133.env (foundation + FlashInfer wheels cached; only the
# overlay rebuilds) plus patches/0001-glm53-pooled-import-and-split-env-registration.patch,
# which:
#   1. restores `from vllm.utils.b12x import get_b12x_sparse_mla` in
#      vllm/models/glm5next/nvidia/pooled_indexer.py -- commit 9c27ec090d
#      deleted the import but left the call at line 134, so every GLM boot
#      dies with NameError during model construction (r39 first hit,
#      2026-09-16). The import is load-bearing: the pooled indexer binds
#      b12x's expand_pooled_topk_to_physical_slots at init and calls it in
#      the forward path (line 646).
#   2. registers VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE /
#      VLLM_GLM53_SPLIT_MAMBA_BLOCK_SIZE in vllm/envs.py -- they are raw-read
#      (platforms/interface.py, v1/core/kv_cache_utils.py) and were never in
#      the registry, so every boot warns "Unknown vLLM environment variable".
#      Registration only silences the warning; behavior is unchanged.
# The VLLM_INTEGRATION_TREE below is the composed tree (patch applied) of
# vllm @ e0f22d9c59 -- required by compose_source whenever a patch file is
# set. Drop this profile once Luke merges the import fix upstream.

IMAGE_REPO=local/vllm
IMAGE_TAG=jovian-judgement-r39-glmsparsemlapatch-cu133
# Names the manifest/transcript AND the vllm package version string
# (VLLM_PACKAGE_VERSION derives from it).
PROFILE_NAME=jj-r39-glmsparsemlapatch-cu133
MAX_JOBS=20

# --- foundation (upstream kimi-k3 cu133 r2 pins; change = rebuild the foundation)
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
PYTORCH_REF=v2.13.0
PYTORCH_COMMIT=cf30153c4c131c8164ee7798e5022d810682e2cb
PYTORCH_VERSION=2.13.0
TORCHVISION_REF=v0.28.0
TORCHVISION_COMMIT=8fb87713a24951e639c494b0f2a8a81b5f8e33a6
TORCHVISION_VERSION=0.28.0
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu133-nccl2312-amd-turin
NCCL_COMMIT=fb6f40999a2a9e63104d4ae4a84118bce61528f8
NCCL_VERSION=2.31.2
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5

# --- FlashInfer wheels (built against the foundation)
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_VERSION=0.6.18+cu133
CUTLASS_DSL_VERSION=4.6.2

# --- overlay: r39 pins + the GLM pooled-indexer patch (local-inference-lab
# branches directly; the patch is sha256-verified in-build and the composed
# tree hash below is verified by compose_source's write-tree check)
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=e0f22d9c5984518498917630845978a0ee82b2e4
VLLM_PATCH_FILE=0001-glm53-pooled-import-and-split-env-registration.patch
VLLM_PATCH_SHA256=79979cdf9f0a0898efa2b6656da5913dfc4dd5e35226ad7f77bd44205bc7d5e9
VLLM_INTEGRATION_TREE=ff635afd9deb018da6090d995ffd8dd68d89f12c
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=5c50b15338641a6538beda38abeedd84cc53f8ac
LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
LMCACHE_COMMIT=29bc5a2efde737c436b04499eb62cd1776cebeec
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
EXLLAMAV3_REPO=https://github.com/brandonmmusic-max/exllamav3.git
EXLLAMAV3_COMMIT=704aefd743b390af4bd0fb429d1906f9b964c7d8
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh serve-ds4-flash-spark.sh

# --- wrapper
LOGGING=1
PIN_PREFLIGHT=1

# --- patches (on | off | auto)
PATCH_GPU_ARCH=auto
PATCH_MAX_JOBS=auto
PATCH_EXLLAMAV3_AVX=auto
PATCH_VLLM_WHEEL_TAGS=auto
# NCCL sm_121 SASS (foundation only). Kept auto: the CURRENT foundation was
# built before this patch existed; rebuilding the foundation is a deliberate
# later bisection step, not part of the overlay-only r39 build.
PATCH_NCCL_GENCODE=auto
