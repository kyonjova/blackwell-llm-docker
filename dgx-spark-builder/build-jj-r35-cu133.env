# build-jj-r35-cu133.env -- r35 reviewed sources on the CUDA 13.3 / torch 2.13
# foundation, for build-spark-cu133.sh (DRAFT wrapper: dry-run validated,
# docker phases not yet run on a Spark).
#
# Three phases: foundation (NGC pytorch:26.07 -> patched NCCL 2.31.2, torch
# 2.13.0 from source at sm_121a, torchvision, xgrammar; hours, built once),
# FlashInfer wheels, then the JJ overlay (vLLM/B12X/LMCache/exllamav3/
# InstantTensor). The overlay verifies each source's git tree hash: the three
# *_INTEGRATION_TREE values below come from rtx6kpro's r35 source lock
# (validation/swiglu-reviewed-composition-r35.source.lock) and match the pins.
PROFILE_NAME=jj-r35-cu133
IMAGE_REPO=local/vllm
IMAGE_TAG=jovian-judgement-r35-cu133
MAX_JOBS=20

# --- foundation (upstream kimi-k3 cu133 r2 pins; change = rebuild the foundation)
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
PYTORCH_REF=v2.13.0
PYTORCH_COMMIT=cf30153c4c131c8164ee7798e5022d810682e2cb
PYTORCH_VERSION=2.13.0
TORCHVISION_REF=v0.28.0
TORCHVISION_COMMIT=8fb87713a24951e639c494b0f2a8a81b5f8e33a6
TORCHVISION_VERSION=0.28.0
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu133-nccl2312-amd-turin
NCCL_COMMIT=fb6f40999a2a9e63104d4ae4a84118bce61528f8
NCCL_VERSION=2.31.2
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5

# --- FlashInfer wheels (built against the foundation)
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_VERSION=0.6.18+cu133
CUTLASS_DSL_VERSION=4.6.2

# --- overlay: r35 reviewed sources (voipmonitor integration/jovian-reviewed-sources-20260911)
VLLM_REPO=https://github.com/voipmonitor/vllm.git
VLLM_PIN=de982a50c6a3e4718e5cf9f00423a92192718da1
VLLM_INTEGRATION_TREE=6d5cc3490735a53e849a4f0909183cb5e3a22e8b
B12X_REPO=https://github.com/voipmonitor/b12x.git
B12X_PIN=98086604c86ec1e78977e5023ce282ecb97ab8a7
B12X_INTEGRATION_TREE=d963f030c72a426753d2afa412b35d29eeb045f7
LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
LMCACHE_COMMIT=29bc5a2efde737c436b04499eb62cd1776cebeec
LMCACHE_INTEGRATION_TREE=5a88a1ea9d2627c76288d056e7193f7454669b64
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
EXLLAMAV3_REPO=https://github.com/brandonmmusic-max/exllamav3.git
EXLLAMAV3_COMMIT=704aefd743b390af4bd0fb429d1906f9b964c7d8
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh

# --- patches (on | off | auto)
PATCH_GPU_ARCH=auto
PATCH_MAX_JOBS=auto
PATCH_EXLLAMAV3_AVX=auto
