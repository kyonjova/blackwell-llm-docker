# build-example.env -- template build manifest for build-spark-cu132.sh.
# Copy it, set the naming block and the two source pins, delete this line.
#
# This file is the source of truth: profile + image digest = reproducible
# build. The script carries the same keys as fallback defaults so a partial
# profile still builds, but a published image should always ship its profile.
#
# Format: plain KEY=VALUE, no quotes, no shell syntax (parsed, not sourced).
# Precedence: process environment > this file > script defaults.
# Validate without building: ./build-spark-cu132.sh --dry-run build-example.env


# -------------------------------------------------------------- image naming
# A docker reference is REPOSITORY:TAG. IMAGE_REPO is the repository half
# (registry host + namespace + name; no host means it stays local), IMAGE_TAG
# is the tag half. The wrapper adds nothing of its own to either: what you
# write here is what gets built, and the two base-stage tags and the wheel
# version derive from it, so this is the one place naming is decided.
#
# A date appears only where you ask for it. <date> expands to YYYYmmdd and
# <datetime> to YYYYmmdd-HHMMSS, anywhere in these values or in PROFILE_NAME.
# Neither is used below on purpose: rebuilding overwrites this tag rather than
# leaving one image set per build day. Add <date> for side-by-side builds.
IMAGE_REPO=local/vllm
IMAGE_TAG=glm53-flash-nvfp4

# Derived from the two lines above unless set here. Setting IMAGE alone also
# works and governs all of them:
#   IMAGE                 local/vllm:glm53-flash-nvfp4
#   SYSTEM_BASE_IMAGE     local/vllm:glm53-flash-nvfp4-system-base
#   BUILD_BASE_IMAGE_TAG  local/vllm:glm53-flash-nvfp4-build-base
#   VLLM_BUILD_VERSION    0.26.1rc0+glm53.flash.nvfp4
#
# The base-stage tags are build-cache handles, not artifacts, derived per
# profile so profiles with different toolchain pins cannot overwrite each
# other's. Profiles sharing a toolchain can share the layers, and the disk:
#SYSTEM_BASE_IMAGE=local/vllm:cu132-sm121-system-base
#BUILD_BASE_IMAGE_TAG=local/vllm:cu132-sm121-build-base


# ------------------------------------------------------------------ wrapper
# LOGGING=1 keeps the full run transcript next to the manifest, on failure
# too. PIN_PREFLIGHT=1 proves both shas resolve before spending the build;
# export GH_TOKEN to make that check reliable on a shared egress IP.
LOGGING=1
PIN_PREFLIGHT=1


# ------------------------------------------------------------------ profile
# Names the manifest and transcript files. Optional: with only IMAGE_TAG set,
# the paperwork is named after the tag. Lowercase [a-z0-9.-].
PROFILE_NAME=glm53-flash-nvfp4

# Serve scripts that must exist in the built image. The cheap guard that the
# vLLM pin really is the branch for this model; verified after the build.
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh


# ------------------------------------------------------------------ sources
# The two pins that decide what this image is. Always shas, never branch
# names: the build stage checks out the ref and then verifies the commit, so
# a branch that advances mid-build fails ~40 minutes in. Resolve one with
#   git ls-remote https://github.com/local-inference-lab/vllm.git dev/jovian-judgement
# and record above the pin what the sha contains and when you took it.
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=54f6e9826c20ef06ed65d838c0ad497ad0abdecf

# B12X. Bump with vLLM when the
# two sides share a contract (KDA metadata, cache selection).
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=139e04048bc3bb4f7210c99e7184d8d2f0e345e7


# ---------------------------------------------------------------- toolchain
# The qualified combination the sm121 images are cut from. Move one line at a
# time and re-measure; the wrapper verifies TORCH_VERSION against the image.
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
DEEPGEMM_REF=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_REF=49b4010afc1cae0441e71fe0b0bffc24fa05e932
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1


# ---------------------------------------------------------------- resources
# A Spark has 20 Grace cores and 128 GB unified memory shared with everything
# else; upstream's MAX_JOBS=64 will thrash it.
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1


# ------------------------------------------------------------ patch toggles
# on = must apply or die; off = skip; auto = apply if the anchor exists, skip
# with a notice once upstream absorbs the fix. Leave on auto.
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_EXLLAMAV3_AVX=auto



