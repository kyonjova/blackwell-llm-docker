# build-jj-r37-cu132.env -- the r37 JOVIAN JUDGEMENT contract, pins only.
#   vLLM  local-inference-lab/vllm dev/jovian-judgement @ fa6ae9212e: the
#         pin of the running r37 image (confirmed by the flashinfer autotune
#         cache key vllmfa6ae9212e in the DSV4 boot logs).
#   B12X  local-inference-lab/b12x @ 135c9715d2: the pin of the running r37
#         image.
# Same sha = same commit, so a rebuild from the lab repos reproduces the
# running image content; only the repo-URL build args change.

IMAGE_REPO=local/vllm
IMAGE_TAG=jovian-judgement-r37-cu132


# ------------------------------------------------------------------ wrapper
# LOGGING=1 keeps the full run transcript next to the manifest, on failure
# too. PIN_PREFLIGHT=1 proves both shas resolve before spending the build;
# export GH_TOKEN to make that check reliable on a shared egress IP.
LOGGING=1
PIN_PREFLIGHT=1


# ------------------------------------------------------------------ profile
# Names the manifest and transcript files. Optional: with only IMAGE_TAG set,
# the paperwork is named after the tag. Lowercase [a-z0-9.-].
PROFILE_NAME=jj-r37
# Serve scripts that must exist in the built image. The cheap guard that the
# vLLM pin really is the branch for this model; verified after the build.
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh serve-ds4-flash-spark.sh

# ------------------------------------------------------------------ sources
# vLLM pin: dev/jovian-judgement @ fa6ae9212e -- the running r37 image pin
# (confirmed by the flashinfer autotune cache key vllmfa6ae9212e in the
# DSV4 boot logs). Branch marker only: the DSV4 pair launcher runs
# `--entrypoint /opt/venv/bin/vllm serve` directly, not an in-image script.
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=fa6ae9212e72edff781cf8ec083a0a9dfc3c58b6

# B12X: local-inference-lab/b12x @ 135c9715d2 -- the running r37 image pin.
# (sparkinfer is the stale pre-rename name; local-inference-lab/sparkinfer
# redirects here.)
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=135c9715d20d8534638b57be8dcd634ab333e87a


# ---------------------------------------------------------------- toolchain
# The qualified combination the sm121 images are cut from. Move one line at a
# time and re-measure; the wrapper verifies TORCH_VERSION against the image.
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
DEEPGEMM_REF=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_REF=49b4010afc1cae0441e71fe0b0bffc24fa05e932
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1


# ---------------------------------------------------------------- resources
# A Spark has 20 Grace cores and 128 GB unified memory shared with everything
# else; upstream's MAX_JOBS=64 will thrash it.
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1

# ------------------------------------------------------------ patch toggles
# on = must apply; off = skip; auto = apply if the anchor exists, skip with
# a notice once upstream absorbs the fix (the retirement path).
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_EXLLAMAV3_AVX=auto
