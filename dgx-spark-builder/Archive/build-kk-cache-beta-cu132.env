# build-kk-beta-cu132.env -- karmic-kraken BETA assembly on the CUDA 13.2 /
# torch 2.13 aarch64 line, for build-spark-cu132.sh.
#
# WHY cu132 (2026-09-23, operator): bench-building on cu133 is deferred --
# the Spark NVIDIA drivers are not good for it yet. The cu132
# system-base/foundation is the long-cached, driver-proven line (r39 ran on
# it), so the first KK bench build rides it. (The published cu134 images are
# additionally x86-only -- see findings.) Nomenclature is "kk-beta" until
# Luke confirms the official r1 tag scheme; build-kk-r1-cu133.env carries
# the karmic-kraken CHANNEL pins (dev/karmic-kraken af9e4dc-era + b12x
# 0f3a8cbf) for when the cu133 line reopens.
#
# PIN SET (2026-09-22, operator decision): build off dev/karmic-kraken +
# b12x master -- NOT the beta branch. (The beta channel's newest assembly,
# karmic-kraken-beta-20260922-3221ccacf71002ea, locks vllm 622912b9 + b12x
# d16e71c3, but its vllm side LACKS the last 12 kk-dev commits -- the
# 2026-09-22 19:00-21:34 batch: caller-owned workspaces #798, NVFP4 loader
# scale-memory fix #805, KDA recovery #821, MTP3 default -- and its b12x
# side is a reconcile line missing master's newest work. Building kk-dev
# makes the assessment coverage exact: every pinned commit is reviewed.)
# Assessment coverage: vllm af9e4dc..6afb999 (41 commits) + b12x
# 0f3a8cbf..4f3028b1 (18 commits) -- see PIN_ASSESSMENT 2026-09-23 entry.
# (No *_INTEGRATION_TREE keys: the cu132 line verifies pins by commit-check
# in-build, not by tree preflight.)
#
# PATCH_DEEPGEMM_LIBDW is REQUIRED for this profile: KK vendors
# vllm-project/DeepGEMM @ ad1f172 whose python_api.cpp pulls
# elfutils/libdwfl.h via the third-party/deep_jit submodule (upstream wheel
# run 35269892481 failed exactly there; vllm 6027a37 added the apt-get). The
# cu132 DeepGEMM stage (stage 2b) runs no apt-get, so the wrapper injects it
# (PATCH_DEEPGEMM_LIBDW=on dies if the anchor moved).
#
# Note on humming/tokenspeed: the PUBLISHED KK wheels strip them
# (normalize_wheel.py), but cu132 overlay still installs both
# (Dockerfile.vllm-b12x-cu132), so MTP_MOE_BACKEND=humming and the tokenspeed
# MLA path remain real options on this image -- unlike on any published KK
# image.

IMAGE_REPO=local/vllm
IMAGE_TAG=karmic-kraken-cache-beta-cu132
PROFILE_NAME=kk-cache-beta-cu132

# --- wrapper
LOGGING=1
PIN_PREFLIGHT=1
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1

# --- serving shape guard (cheap check that the pin really is the KK GLM line)
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh serve-ds4-flash-spark.sh

# ---------------------------------------------------------------- sources
# vLLM: dev/karmic-kraken tip (2026-09-23, delta #3: + the io_uring loader
# pairing f92c576283, prepared block-FP8/WO capacity contracts cff8aebfeb,
# Qwen MTP5/MTP8 57fdda71b0; the 2026-09-22 line carried the
# beta memory fixes via PRs (#809 checkpoint-aware KV admission, #801/#803
# probe/owner release, #806 DCP storage reuse), the big caller-owned
# workspace port #798, the GLM NVFP4 loader scale-memory fix #805 (GB10 load
# OOM), auto KDA recovery #821 (--no-use-replayssm opt-out), Qwen QSA decode
# CP #819, MTP positional overrides #837, CuMem draft inheritance #834, spec
# config hash #820, and the GLM TP2 MTP3 default 6afb999.
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=1794dcf18454900263e0c66711af8ea4a1283ac1

# B12X: master tip (2026-09-23, delta #3: + io_uring O_DIRECT loader
# 1ec67ef6, selection-cache schema 6 ae431182, serialized block-FP8 within
# prepared capacity 0332cc50). The 2026-09-22 line: silicon-keyed tuning
# cache f818b3ab,
# distributed-tuning compatibility 5a53424d (BLOCKING for KK TP2 tuning),
# KDA accepted-state recovery #408, RoCEnante traffic class c2dc1cf0 (inert
# on direct-cable pair, ABI 4 -> proxy rebuild on both nodes), Spark
# decode/indexer improvements 1dc77276, FA2-aligned normalization 6394341b.
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=a7d7d29b2ef8869086e0ceaa787321f17544e3c9

# DeepGEMM: match KK's vendored pin (vllm-project fork @ ad1f172 -- same pin
# at af9e4dc and 622912b9). GLM serves --linear-backend b12x, so this only
# affects DS4 deep_gemm dispatch. aarch64 build risk noted in the header.
DEEPGEMM_REPO=https://github.com/vllm-project/DeepGEMM.git
DEEPGEMM_REF=ad1f1726aa540a76c1d26d6a120effb8de21eaa4
DEEPGEMM_COMMIT=ad1f1726aa540a76c1d26d6a120effb8de21eaa4

# InstantTensor: LIL main = the assembly's pin (0.1.9). The r39 pin 49b4010
# is on this repo too; both carry libaio submodule 1b18bfa.
INSTANTTENSOR_REPO=https://github.com/local-inference-lab/InstantTensor.git
INSTANTTENSOR_REF=95d4729b6d6a991bb8de61877147a9d9d9100b23
INSTANTTENSOR_COMMIT=95d4729b6d6a991bb8de61877147a9d9d9100b23

# LMCache: local-inference-lab integration/local-inference-lab @ 9acfefdb
# (2026-09-25, PR #91; tagged lmcache-cu134-sm120-beta-9acfefdb...). Replaces
# the unpinned release/v0.5.2-glm52-dcp-base head the build used to float on.
# Carries the recurrent request-boundary checkpoint line (#81-#91: L2
# on-reuse/on-evict store policies, supersession retention, shutdown flush,
# 65536-entry manifest index, bounded admission waits) and the multi-server
# LMCacheMPConnector (lmcache.mp.server_urls: one server per node, workers
# route to their node's server, lookups take the min across servers).
# REF = the sha on purpose: the Dockerfile checks out REF and requires
# HEAD == COMMIT, so a branch REF breaks the build when the branch moves.
# Version = what setuptools_scm would derive (v0.5.2-cu129 + 385 commits),
# with a local label naming the commit; the final stage asserts it.
# PATCH_LMCACHE_INTEGRATION=on rewrites the stage-3 test list and the
# final-stage API check for this lineage (see the wrapper). NOT qualified
# for serving on the pair: integration is shelved until topology support
# is decided (claude/lmcache-findings.md) -- this only keeps the image ready.
LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
LMCACHE_REF=9acfefdb59abde6e0500a6a9518c85d816465258
LMCACHE_COMMIT=9acfefdb59abde6e0500a6a9518c85d816465258
LMCACHE_BUILD_VERSION=0.5.3.dev385+lil.9acfefdb
PATCH_LMCACHE_INTEGRATION=on

# SparkCache: FujitsuPolycom/sparkcache main @ 801f7f9a (2026-09-19, 0.1.0a3
# source). Pure-Python KV connector (no dependencies) for a persistent,
# rank-local NVMe prefix cache; loaded per launch via --kv-transfer-config and
# inert unless a launcher configures it.
# SPARKCACHE_VLLM_PATCHES: files in ./patches/ applied IN ORDER to the
# installed vLLM (comma-separated, no spaces; patches/README-sparkcache.md):
#   01-vmm-exemption      REQUIRED -- lets the connector run
#                         expandable_segments allocator (upstream 020)
#   02-shared-prefix-lease optional -- concurrent requests with the same
#                         stored prefix share one restored GPU copy
#                         (upstream 040+041, rebased onto e77be225; compile-
#                         and placement-checked, NOT yet runtime-tested).
#                         Drop it from the list to build with 01 only.
# Both carry a SparkCache-vLLM-Pin header; the wrapper refuses them once
# VLLM_PIN moves off e77be225 until they are rebased.
SPARKCACHE_REPO=https://github.com/FujitsuPolycom/sparkcache
SPARKCACHE_COMMIT=801f7f9a4bd83de8fddc35bda721089acf16584a
SPARKCACHE_VLLM_PATCHES=sparkcache-vllm-e77be225-01-vmm-exemption.patch,sparkcache-vllm-e77be225-02-shared-prefix-lease.patch
PATCH_SPARKCACHE=on

# exllamav3: unchanged (EXL3 path, unrelated to GLM/KK).
EXLLAMAV3_COMMIT=704aefd743b390af4bd0fb429d1906f9b964c7d8

# ------------------------------------------------------------- toolchain
# UNCHANGED from r39-cu132 on purpose: the system-base/foundation images are
# built and cached; this profile changes ONLY the overlay sources. Changing
# any line below rebuilds the foundation (hours) and re-opens the cu132
# driver/toolchain qualification.
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
# FlashInfer: the r39 pin, kept deliberately. The LIL repo has no cu132
# community branch (only cu133/cu134), so the repo-standardization stays
# deferred on this line; the pin exists on both remotes and the cached wheel
# image stays valid. Revisit only if a KK FlashInfer behavior change is
# suspected.
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1

# ------------------------------------------------------------ patch toggles
# on = must apply; off = skip; auto = apply if the anchor exists, skip with
# a notice once upstream absorbs the fix (the retirement path).
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_VLLM_WHEEL_TAGS=auto
PATCH_EXLLAMAV3_AVX=auto
# Required on every karmic-kraken pin (see header). on = die if the DeepGEMM
# clone anchor moved, rather than silently building without libdw-dev.
PATCH_DEEPGEMM_LIBDW=on
# b12x loader io_uring path: liburing-dev + pkg-config in the final stage
# (replaces the derived ...-io-uring image) and KK's seccomp profile baked at
# /opt/local-inference/seccomp/spark-io-uring.json, fetched from the PINNED
# vLLM commit (scripts/seccomp/spark-io-uring.json; present and identical at
# 57fdda71 and e77be225, sha256 823b66051a52...). on = die if the fetch fails.
# The image cannot apply the profile to itself: install it once per node as
# the docker daemon default (verify-image-cu132.sh prints the commands).
# SECCOMP_PROFILE_SRC=<path> overrides the fetch for air-gapped builders.
PATCH_IO_URING=on
