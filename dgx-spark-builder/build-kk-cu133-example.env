# build-kk-cu133-example.env -- karmic-kraken pins on the CUDA 13.3 / torch 2.13
# foundation, for build-spark-cu133.sh. TEMPLATE that also dry-runs as-is
# (pin set name `beta1`): copy to build-kk-r1-cu133.env, rename the pin set in
# IMAGE_TAG / PROFILE_NAME / LMCACHE_BUILD_VERSION, and replace the six overlay
# pins + trees when Luke tags an official KK r1. Every repository is
# local-inference-lab; the historical voipmonitor forks (flashinfer,
# InstantTensor) are superseded -- their pins exist on the LIL repos too, so an
# older env file still resolves.
#
# Pin sets (2026-09-19). Two KK lines exist and they are NOT nested:
#   beta  vllm integration/karmic-kraken-beta @ 67bb922 + b12x integration/karmic-kraken-beta @ eea3ced
#         = the published ghcr.io/local-inference-lab/vllm:karmic-kraken-beta-20260919-cfc67a15ebc3daf7
#         (~40 GLM memory-bounding commits; LACKS the startup rank-coordination fix)
#   r1    vllm dev/karmic-kraken @ af9e4dc + b12x master @ 0f3a8cb
#         = the `karmic-kraken` channel (tuning cache agreement 0f60770 / b12x 06809d5,
#         startup memory reclaim 298f265; LACKS the beta memory commits)
# The active block below is the beta assembly (mirrors a qualified image);
# the r1 block is commented at the end. Swap all six values together.
#
# Foundation and FlashInfer phases: foundation pins are deliberately the r39
# ones (cached; cu132-vs-cu133 comparison stays a toolchain-only diff).
# FlashInfer moves to the LIL cu133 community branch (1ac6942 + three DSV4
# Vision sm120 fixes) -- that invalidates the cached FlashInfer wheel image;
# set FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f to reuse it.
#
# Requires the wrapper's PATCH_DEEPGEMM_LIBDW: KK's cmake vendors
# vllm-project/DeepGEMM @ ad1f172 whose python_api.cpp includes
# elfutils/libdwfl.h, and the cu133 overlay runs no apt-get.

IMAGE_REPO=local/vllm
IMAGE_TAG=karmic-kraken-beta1-cu133
# Names the manifest/transcript AND the vllm package version string
# (VLLM_PACKAGE_VERSION derives from it: 0.26.1rc0+kk.beta1.cu133.sm121.<date>).
PROFILE_NAME=kk-beta1-cu133
MAX_JOBS=20

# --- foundation (unchanged from r39-cu133; change = rebuild the foundation)
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
PYTORCH_REF=v2.13.0
PYTORCH_COMMIT=cf30153c4c131c8164ee7798e5022d810682e2cb
PYTORCH_VERSION=2.13.0
TORCHVISION_REF=v0.28.0
TORCHVISION_COMMIT=8fb87713a24951e639c494b0f2a8a81b5f8e33a6
TORCHVISION_VERSION=0.28.0
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu133-nccl2312-amd-turin
NCCL_COMMIT=fb6f40999a2a9e63104d4ae4a84118bce61528f8
NCCL_VERSION=2.31.2
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5

# --- FlashInfer wheels (built against the foundation)
# local-inference-lab/flashinfer community/jovian-judgement-cu133-sm120:
#   803c466 fix(sm120): dispatch runtime extra top-k for DSV4 Vision
#   b1edc38 fix(sm120): support DSV4 Vision TP1 dual prefill
#   adaa8cb fix(sm120): support DSv4 Vision dual prefill
#   1ac6942 fix(comm): qualify PCIe IPC all-reduce for DS4 TP2   <- r39 pin
# The published cu134 channel builds community/jovian-judgement-cu134-sm120 @ 2206a14.
FLASHINFER_REPO=https://github.com/local-inference-lab/flashinfer.git
FLASHINFER_REF=community/jovian-judgement-cu133-sm120
FLASHINFER_COMMIT=803c4664f4771ddc418f20a57f752469a237a825
FLASHINFER_VERSION=0.6.18+cu133
# 4.6.2 is what the published KK image runs (normalize_wheel rewrites vLLM's
# 4.7.1 requirement); B12X CuTeDSL kernels are qualified against it.
CUTLASS_DSL_VERSION=4.6.2

# --- overlay: karmic-kraken BETA assembly cfc67a15 (published 2026-09-19)
# *_INTEGRATION_TREE = the commit's own tree (unpatched pins), so the tree
# pre-flight needs no GitHub API round-trip.
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=67bb922f6f401b304abb8a6d9da450445c962662
VLLM_INTEGRATION_TREE=de75fce3681a81d933682dd6996191df944fb468
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=eea3ced11fc14625b683d3c575cf2d702ad3706a
B12X_INTEGRATION_TREE=f595735171e9878940da38044055a481986d05c7
LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
LMCACHE_COMMIT=688bee14e157b64623d93c07fc0d4db93470e12f
LMCACHE_INTEGRATION_TREE=fa24eb3adba2015056d76a42fcd6f660e590460e
# Published LMCache is 0.5.3.dev365+lil.cu134.g688bee14e157; the wrapper
# rewrites the pip-check allowlist token to whatever is set here.
LMCACHE_BUILD_VERSION=0.5.3+kk.beta1.cu133

# DeepGEMM: match KK's vendored pin (vllm-project fork) so the standalone
# site-packages copy that vllm/utils/deep_gemm.py prefers is the same code the
# cmake build compiled. GLM serves with --linear-backend b12x, so this only
# affects DS4 deep_gemm dispatch; if the fork fails to build on aarch64, fall
# back to deepseek-ai/DeepGEMM @ a6b593d2826719dcf4892609af7b84ee23aaf32a.
DEEPGEMM_REPO=https://github.com/vllm-project/DeepGEMM.git
DEEPGEMM_COMMIT=ad1f1726aa540a76c1d26d6a120effb8de21eaa4

# InstantTensor: LIL main = the published cu134 channel's pin (0.1.9). The r39
# pin 49b4010afc1cae0441e71fe0b0bffc24fa05e932 is on this repo too; both carry
# libaio submodule 1b18bfa, so the wrapper's INSTANTTENSOR_LIBAIO_* defaults hold.
INSTANTTENSOR_REPO=https://github.com/local-inference-lab/InstantTensor.git
INSTANTTENSOR_COMMIT=95d4729b6d6a991bb8de61877147a9d9d9100b23
# exllamav3: unchanged (EXL3 path, unrelated to GLM/KK)
EXLLAMAV3_REPO=https://github.com/brandonmmusic-max/exllamav3.git
EXLLAMAV3_COMMIT=704aefd743b390af4bd0fb429d1906f9b964c7d8
# Both launchers exist at the KK repo root (verified on 67bb922 and af9e4dc).
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh serve-ds4-flash-spark.sh

# --- wrapper
LOGGING=1
PIN_PREFLIGHT=1

# --- patches (on | off | auto)
PATCH_GPU_ARCH=auto
PATCH_MAX_JOBS=auto
PATCH_EXLLAMAV3_AVX=auto
PATCH_VLLM_WHEEL_TAGS=auto
# NCCL sm_121 SASS (foundation only). Kept auto: the current foundation was
# built before this patch existed; rebuilding it is a separate bisection step.
PATCH_NCCL_GENCODE=auto
# Required on every karmic-kraken pin (see header). `on` = die if the overlay's
# DeepGEMM stage anchor moved, rather than silently building without libdw-dev.
PATCH_DEEPGEMM_LIBDW=on

# --- r1 pin set: the `karmic-kraken` channel (dev/karmic-kraken + b12x master).
# Replace the six overlay values above with these for the deadlock repro
# (tuning cache agreement + startup memory reclaim). LMCache pin is the same.
#   VLLM_PIN=af9e4dca109e0348323c0182e98a3aaf7282bfc3
#   VLLM_INTEGRATION_TREE=5c4050842696884679d7ab65fd6f555fa680e030
#   B12X_PIN=0f3a8cbfd1c11d27f04e3ab37a802d522f4f1c68
#   B12X_INTEGRATION_TREE=ff2218d710ca9cae71459e1b9eb7ca3fe10ae08e
# When an official r1 lands, take the six values from the image's
# /opt/venv/share/lil-runtime/manifest.json (assembly.components.*.source_commit)
# and compute each tree with: git rev-parse <sha>^{tree}
