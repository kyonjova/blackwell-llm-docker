# build.env -- FULL build manifest for build-spark-cu132.sh
# This file is the source of truth: every source repo, ref, commit, and
# version pin for the image is stated here explicitly, so this one file plus
# the image digest makes a build reproducible (publishing-checklist ready).
# The script carries the same values as fallback defaults, so a missing or
# partial profile still builds -- but a published image should always ship
# its profile.
#
# Format: plain KEY=VALUE, no quotes, no shell syntax (parsed, not sourced).
# Precedence: process environment > this file > script defaults.

# ------------------------------------------------------------------ profile
PROFILE_NAME=glm53-nvfp4
# Serve scripts that MUST exist in the finished image -- the cheap guard
# that VLLM_REF really is the branch for this model family.
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh

# ------------------------------------------------------------------ sources
# vLLM pin: 2026-08-29 evening dev/jovian-judgement HEAD (0b67266a).
# Carries, cumulatively: the 4p67 loader + TP2 mixed-quant memory work
# (8590bf9c), bounded TP2 checkpoint-loading memory + optional InstantTensor
# copies (e823e48c/c5f47c6d), the B12X KDA live-tensor decode perf line
# (eda08cc3/852537e6/0b67266a), opt-in adaptive MTP depth
# (f71e0dea/e10536aa), shared planner scratch (d65b96b1), and single-row
# vocab projection (0ca18da0). Last pair-validated pin: da4d7be6 (08-28).
# NOTE: the KDA commits pair with the sparkinfer pin below -- bump BOTH
# together (the live-tensor binding expects the new b12x metadata contract).
# Move the pin with:
#   git ls-remote https://github.com/local-inference-lab/vllm.git dev/jovian-judgement
VLLM_PIN=0b67266a0f37d6146a8403fb8482403c62f412d5
# sparkinfer/B12X: 2026-08-29 evening master HEAD (bdd7a26e). Adds the
# b12x side of the KDA live-tensor contract (b1d541f/00f7d4b/f1a37c8 --
# REQUIRED by the vLLM pin above), extended GB10 MoE profile coverage
# (bdd7a26), the complete GB10 all-component kernel profile (11814a2),
# autotuned BF16 vocab projection (ff9abf8), and the multi-GPU autotuner,
# on top of the SM120/SM121-gated MXFP8 GEMM.
# Previous validated pin: 2fcf23a0 (2026-08-28).
B12X_PIN=bdd7a26ea306b9ddda300ba893ff7e4be7127c7b
B12X_REPO=https://github.com/local-inference-lab/sparkinfer.git
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu132-nccl2304-amd-noxml
NCCL_COMMIT=dfab7c1ace32da250ba97757879429c341b7bcf9
FLASHINFER_REPO=https://github.com/voipmonitor/flashinfer.git
FLASHINFER_REF=integration/main-pr4393-pcie-ipc-qualified-20260807
FLASHINFER_COMMIT=1ac6942776b383c6b03c7a5805a22e72a3e3349f
FLASHINFER_BUILD_CUBIN=0
TORCH_VERSION=2.13.0+cu132
TORCHVISION_VERSION=0.28.0+cu132
TORCH_BUNDLED_NCCL_VERSION=2.29.7
CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_COMMIT=e6233cbac5d7c7a865c19c91cd684ceece19513c
CUTLASS_DSL_VERSION=4.6.2
TILELANG_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.1.8
TVM_FFI_VERSION=0.1.11
QUACK_KERNELS_SPEC=quack-kernels==0.6.4
FASTSAFETENSORS_SPEC=fastsafetensors>=0.3.3
HUMMING_KERNELS_SPEC=humming-kernels[cu13]==0.1.12
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5
XGRAMMAR_TRANSFORMERS5_COMPAT=1
DEEPGEMM_REF=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
INSTANTTENSOR_REPO=https://github.com/voipmonitor/InstantTensor.git
INSTANTTENSOR_REF=49b4010afc1cae0441e71fe0b0bffc24fa05e932
INSTANTTENSOR_COMMIT=49b4010afc1cae0441e71fe0b0bffc24fa05e932
VLLM_RUNTIME_EXTRA_PACKAGES=nvtx==0.2.15 nccl4py==0.3.1
MAX_JOBS=20
VLLM_MAX_JOBS=20
NVCC_THREADS=1
VLLM_NVCC_THREADS=1
PIN_SOURCE_COMMITS=1

# ------------------------------------------------------------ patch toggles
# on = must apply; off = skip; auto = apply if the anchor exists, skip with
# a notice once upstream absorbs the fix (the retirement path).
PATCH_GPU_ARCH=auto
PATCH_HOST_ARCH=auto
PATCH_PCIE_ENV=auto
PATCH_PIPCHECK_WHEELTAG=auto
PATCH_VLLM_REQ_MARKERS=auto
PATCH_EXLLAMAV3_AVX=auto

# --------------------------------------------------------------- overrides
# Image naming defaults to local/vllm:${PROFILE_NAME}-jj-b12x-cu132-sm121-<date>;
# uncomment to pin explicitly.
#IMAGE=local/vllm:glm53-nvfp4-custom
