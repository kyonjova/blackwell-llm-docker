# build-kk-r1-cu133.env -- karmic-kraken R1 pins on the CUDA 13.3 / torch 2.13
# foundation, for build-spark-cu133.sh. Built from build-kk-cu133-example.env
# with the r1 pin set active (the commented block in the example).
#
# OFFICIAL R1 (verified 2026-09-21 from the release receipt):
#   channel   karmic-kraken (vllm dev/karmic-kraken + b12x master)
#   assembly  karmic-kraken-20260920-919cdcb950d4c242  (2026-09-20T22:20Z)
#   digest    ghcr.io/local-inference-lab/vllm@sha256:6988c9d764449e394b74b12a6728ff940dee5c60cbc12635fa0fd69b7113d8a0
#   release   local-inference-lab/blackwell-llm-docker/releases/tag/karmic-kraken-919cdcb950d4c24241eee64385fe6594c30cceea5b85f77acb9da89890600b61
#   locks     vllm af9e4dca10 / b12x 0f3a8cbfd / lmcache 688bee1 /
#             instanttensor 95d4729 / flashinfer 2206a14 (cu134 community) /
#             nccl 93fe05d (cu134 branch)
# In-image config verified: amd64/linux, 68 layers, NO baked NCCL_NET_PLUGIN
# (foundation ENV audit holds on the r1 assembly).
#
# cu133 deltas vs the published r1 (all deliberate, toolchain-only):
#   - FlashInfer: community/jovian-judgement-cu133-sm120 @ 803c466 (the cu134
#     lock 2206a14 is the cu134-sm120 branch; the cu133 community branch is
#     1ac6942 + three DSV4 Vision sm120 fixes).
#   - NCCL: canonical/cu133-nccl2312-amd-turin @ fb6f409 (2.31.2; the lock's
#     93fe05d is the cu134 branch).
#   - Everything else (torch 2.13.0 foundation, xgrammar, cutlass-dsl 4.6.2)
#     is identical to the r39-cu133 foundation pins -- cached foundation.
#
# NOTE: r1 LACKS the beta-only memory commits (82 on integration/
# karmic-kraken-beta: recurrent-endpoint KV-pool sizing fd047dd/02dc274,
# bounded prompt-tail checkpoint eb4ec03, ...). r1 HAS the startup
# rank-coordination fix (0f60770 + b12x 06809d5) -- this is the build for the
# cold-cache deadlock repro. The beta assembly is a follow-up
# RUNTIME_FOUNDATION=1 overlay rebuild (six-value swap from the example env).

IMAGE_REPO=local/vllm
IMAGE_TAG=karmic-kraken-r1-cu133
# Names the manifest/transcript AND the vllm package version string
# (VLLM_PACKAGE_VERSION derives from it -- note the wrapper's default doubles
# the ".cu133" segment: 0.26.1rc0+kk.r1.cu133.cu133.sm121.<date>; cosmetic,
# set VLLM_PACKAGE_VERSION explicitly if a clean string matters).
PROFILE_NAME=kk-r1-cu133
MAX_JOBS=20

# --- foundation (unchanged from r39-cu133; change = rebuild the foundation)
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
PYTORCH_REF=v2.13.0
PYTORCH_COMMIT=cf30153c4c131c8164ee7798e5022d810682e2cb
PYTORCH_VERSION=2.13.0
TORCHVISION_REF=v0.28.0
TORCHVISION_COMMIT=8fb87713a24951e639c494b0f2a8a81b5f8e33a6
TORCHVISION_VERSION=0.28.0
NCCL_REPO=https://github.com/local-inference-lab/nccl-canonical.git
NCCL_REF=canonical/cu133-nccl2312-amd-turin
NCCL_COMMIT=fb6f40999a2a9e63104d4ae4a84118bce61528f8
NCCL_VERSION=2.31.2
XGRAMMAR_REF=v0.2.5
XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
XGRAMMAR_VERSION=0.2.5

# --- FlashInfer wheels (built against the foundation)
# local-inference-lab/flashinfer community/jovian-judgement-cu133-sm120:
#   803c466 fix(sm120): dispatch runtime extra top-k for DSV4 Vision
#   b1edc38 fix(sm120): support DSV4 Vision TP1 dual prefill
#   adaa8cb fix(sm120): support DSv4 Vision dual prefill
#   1ac6942 fix(comm): qualify PCIe IPC all-reduce for DS4 TP2   <- r39 pin
FLASHINFER_REPO=https://github.com/local-inference-lab/flashinfer.git
FLASHINFER_REF=community/jovian-judgement-cu133-sm120
FLASHINFER_COMMIT=803c4664f4771ddc418f20a57f752469a237a825
FLASHINFER_VERSION=0.6.18+cu133
# 4.6.2 is what the published KK image runs (normalize_wheel rewrites vLLM's
# 4.7.1 requirement); B12X CuTeDSL kernels are qualified against it.
CUTLASS_DSL_VERSION=4.6.2

# --- overlay: karmic-kraken R1 (channel lock, assembly 919cdcb9, 2026-09-20)
# *_INTEGRATION_TREE = the commit's own tree (unpatched pins), so the tree
# pre-flight needs no GitHub API round-trip.
VLLM_REPO=https://github.com/local-inference-lab/vllm.git
VLLM_PIN=af9e4dca109e0348323c0182e98a3aaf7282bfc3
VLLM_INTEGRATION_TREE=5c4050842696884679d7ab65fd6f555fa680e030
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_PIN=0f3a8cbfd1c11d27f04e3ab37a802d522f4f1c68
B12X_INTEGRATION_TREE=ff2218d710ca9cae71459e1b9eb7ca3fe10ae08e
LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
LMCACHE_COMMIT=688bee14e157b64623d93c07fc0d4db93470e12f
LMCACHE_INTEGRATION_TREE=fa24eb3adba2015056d76a42fcd6f660e590460e
# Published LMCache (same commit on the r1 lock) is
# 0.5.3.dev365+lil.cu134.g688bee14e157; the wrapper rewrites the pip-check
# allowlist token to whatever is set here.
LMCACHE_BUILD_VERSION=0.5.3+kk.r1.cu133

# DeepGEMM: match KK's vendored pin (vllm-project fork) so the standalone
# site-packages copy that vllm/utils/deep_gemm.py prefers is the same code the
# cmake build compiled. GLM serves with --linear-backend b12x, so this only
# affects DS4 deep_gemm dispatch; if the fork fails to build on aarch64, fall
# back to deepseek-ai/DeepGEMM @ a6b593d2826719dcf4892609af7b84ee23aaf32a.
DEEPGEMM_REPO=https://github.com/vllm-project/DeepGEMM.git
DEEPGEMM_COMMIT=ad1f1726aa540a76c1d26d6a120effb8de21eaa4

# InstantTensor: LIL main = the r1 lock's pin (0.1.9). The r39 pin 49b4010 is
# on this repo too; both carry libaio submodule 1b18bfa, so the wrapper's
# INSTANTTENSOR_LIBAIO_* defaults hold.
INSTANTTENSOR_REPO=https://github.com/local-inference-lab/InstantTensor.git
INSTANTTENSOR_COMMIT=95d4729b6d6a991bb8de61877147a9d9d9100b23
# exllamav3: unchanged (EXL3 path, unrelated to GLM/KK)
EXLLAMAV3_REPO=https://github.com/brandonmmusic-max/exllamav3.git
EXLLAMAV3_COMMIT=704aefd743b390af4bd0fb429d1906f9b964c7d8
# Both launchers exist at the KK repo root (verified on af9e4dc = the r1 lock).
VLLM_REQUIRED_LAUNCHERS=serve-glm53-flash-nvfp4.sh serve-ds4-flash-spark.sh

# --- wrapper
LOGGING=1
PIN_PREFLIGHT=1

# --- patches (on | off | auto)
PATCH_GPU_ARCH=auto
PATCH_MAX_JOBS=auto
PATCH_EXLLAMAV3_AVX=auto
PATCH_VLLM_WHEEL_TAGS=auto
# NCCL sm_121 SASS (foundation only). Kept auto: the current foundation was
# built before this patch existed; rebuilding it is a separate bisection step.
PATCH_NCCL_GENCODE=auto
# Required on every karmic-kraken pin (see header). `on` = die if the overlay's
# DeepGEMM stage anchor moved, rather than silently building without libdw-dev.
PATCH_DEEPGEMM_LIBDW=on
# FetchContent hygiene for the vLLM extension cache mount. The first KK build
# (2026-09-20) died in cmake configure: the r39 cache still held
# _deps/flashkda-src at JJ's pin with the PATCH_COMMAND applied, and
# FetchContent's stash/checkout/unstash to KK's b59532f conflicted in
# csrc/smxx/fwd_launch.cu. RESET clears _deps/*-src and *-subbuild before
# cmake (re-fetch at the pinned tags; *-build objects survive). CACHE_ID
# gives the KK line its own BuildKit mount id so JJ and KK builds stop
# invalidating each other -- per LINE, not per release, so r1 -> r2 reuses
# objects.
PATCH_VLLM_DEPS_RESET=on
VLLM_EXT_CACHE_ID=kk
